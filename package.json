{
  "name": "dph-nuxt-stuff",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "turbo run test",
    "publint": "turbo run publint",
    "publishing-contract": "node release/publishing-contract/cli.ts",
    "check": "pnpm publishing-contract && pnpm typecheck && pnpm format && pnpm lint && pnpm knip && pnpm test && pnpm build && pnpm publint",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "knip": "knip",
    "commitlint": "commitlint --edit",
    "scaffold": "jiti scaffolder/cli.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/node": "catalog:",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "catalog:",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.31.0",
    "oxfmt": "^0.61.0",
    "oxlint": "catalog:",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
