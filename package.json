{
  "name": "dph-nuxt-stuff",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check": "pnpm typecheck && pnpm format && pnpm lint",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "knip": "knip",
    "commitlint": "commitlint --edit",
    "release": "changelogen --release --push --publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.76.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.31.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.8",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.8.tsgo.7.0.2"
  },
  "packageManager": "pnpm@11.18.0"
}
