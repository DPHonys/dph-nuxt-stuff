{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "templates/**",
    "tsconfig.json",
    "*.config.ts",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".nuxt/**", ".output/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md"],
      "outputs": []
    },
    "publint": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
