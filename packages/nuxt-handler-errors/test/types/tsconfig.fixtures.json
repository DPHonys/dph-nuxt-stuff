{
  "$schema": "https://json.schemastore.org/tsconfig",

  // The compiler options every fixture is compiled under, and the file list
  // every fixture program is seeded with alongside the one fixture under test.
  //
  // This config is never built or checked as a project. `test/types/harness.ts`
  // reads it with `readConfigFile` + `parseJsonConfigFileContent` and hands
  // `createProgram` the fixture plus `parsed.fileNames` (SPEC.md §9.9 trap 4),
  // which is why `include` names the ambient declarations rather than the
  // fixtures: the fixtures arrive one at a time, alone (SPEC.md §9.2).
  //
  // The options mirror the package's own program where it can affect a type
  // assertion — `strict`, `exactOptionalPropertyTypes` and
  // `noUncheckedIndexedAccess` all change what a fixture proves. `types` is
  // empty on purpose: a fixture that needs an ambient world should say so
  // through `include` or `ambientFiles`, not inherit one.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["ambient/**/*.d.ts"]
}
