{
  "extends": ["./.nuxt/tsconfig.json", "../../tsconfig.json"],
  // `test/types/neg` is deliberately non-compiling: those fixtures exist to
  // produce specific diagnostics, which the harness reads back through its own
  // program. Left in this one they would fail `typecheck`.
  //
  // `test/types/pos/unreachable-map-key.ts`, `test/types/pos/lookup.ts`,
  // `test/types/pos/typed-fetch.ts` and `test/types/pos/event-typed-fetch.ts`
  // are
  // excluded for the opposite reason: they compile fine, but they augment
  // `nitropack/types`' `InternalApi`, and a module augmentation is **global to
  // whatever program contains it**. Measured: with one extra route key in
  // scope, `$fetch('/api/users/42')` in `test/wire.test.ts` becomes `TS2321
  // Excessive stack depth`, reproduced by nothing
  // more than a fixture being on the wrong side of an `include`. The harness
  // compiles both alone, which is where they belong.
  "exclude": [
    "dist",
    "node_modules",
    "playground",
    "test/types/neg",
    "test/types/pos/event-typed-fetch.ts",
    "test/types/pos/lookup.ts",
    "test/types/pos/typed-fetch.ts",
    "test/types/pos/unreachable-map-key.ts"
  ]
}
