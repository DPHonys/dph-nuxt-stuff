{
  "extends": ["./.nuxt/tsconfig.json", "../../tsconfig.json"],
  // `test/types/fixtures` holds deliberately broken sources: they are compiled
  // by `test/types/compile-harness.ts`, which asserts on the diagnostics they
  // produce, so this project must not report them as its own failures.
  // `test/fixtures/native` is an app whose checks mean something only inside
  // its own generated programs, which `test/e2e/native-engine.test.ts`
  // compiles, routes included; its config sets a flag Nuxt 4.0 does not type.
  "exclude": [
    "dist",
    "node_modules",
    "playground",
    "test/types/fixtures",
    "test/fixtures/native"
  ]
}
