{
  "$schema": "https://json.schemastore.org/tsconfig",

  // A fixture config that reaches **nothing but the file under inspection**.
  //
  // It exists for exactly one self-test: the
  // first attempt at a hover renderer passed only the target file, every lookup
  // silently came back `unknown`/`any`, and the harness therefore passed
  // everything. This config reproduces that program on demand, so the guard
  // against it — `renderHover` refusing to report `any` — is asserted rather
  // than asserted-about.
  //
  // Nothing else may use it. `tsconfig.fixtures.json` is the real one.
  "extends": "./tsconfig.fixtures.json",
  "include": ["pos/harness-hover.ts"]
}
