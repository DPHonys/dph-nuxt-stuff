{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then pnpm install --frozen-lockfile; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git *)",
      "Bash(gh api *)",
      "Bash(sleep *)",
      "Bash(date *)"
    ]
  },
  "attribution": {
    "sessionUrl": false
  }
}
